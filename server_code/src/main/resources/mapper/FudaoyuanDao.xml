<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.FudaoyuanDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.FudaoyuanEntity" id="fudaoyuanMap">
        <result property="fudaoyuanzhanghao" column="fudaoyuanzhanghao"/>
        <result property="mima" column="mima"/>
        <result property="fudaoyuanxingming" column="fudaoyuanxingming"/>
        <result property="touxiang" column="touxiang"/>
        <result property="lianxifangshi" column="lianxifangshi"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.FudaoyuanView" >

		SELECT  fudaoyuan.* FROM fudaoyuan  fudaoyuan 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.FudaoyuanView" >
		SELECT * FROM fudaoyuan  fudaoyuan <where> 1=1 ${ew.sqlSegment}</where>
	</select>



</mapper>
